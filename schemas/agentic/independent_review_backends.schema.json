{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footballprediction.local/schemas/agentic/independent-review-backends-v1.json",
  "type": "object", "additionalProperties": false, "required": ["registry_version", "backends"],
  "properties": {"registry_version": {"const": "independent-review-backends/v1"}, "backends": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["backend_id", "harness_id", "provider_id", "status", "allowed_requested_models", "minimum_harness_version", "required_provenance_fields", "isolation_requirements", "transport_policy", "task_eligibility", "no_silent_fallback"], "properties": {"backend_id": {"pattern": "^[a-z0-9][a-z0-9-]{1,63}$"}, "harness_id": {"type": "string", "minLength": 1}, "provider_id": {"type": "string", "minLength": 1}, "status": {"enum": ["active", "reserved", "disabled"]}, "allowed_requested_models": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "minimum_harness_version": {"type": "string", "minLength": 1}, "required_provenance_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "isolation_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "transport_policy": {"type": "string", "minLength": 1}, "task_eligibility": {"type": "array", "minItems": 1, "items": {"enum": ["NORMAL", "STRICT", "CRITICAL"]}}, "no_silent_fallback": {"const": true}}}}}
