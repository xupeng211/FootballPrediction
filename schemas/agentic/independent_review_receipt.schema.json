{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footballprediction.local/schemas/agentic/independent-review-receipt-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "receipt_version", "review_run_id", "review_backend", "review_harness", "provider", "requested_model", "base_sha", "head_sha", "diff_sha256", "mission_id", "mission_scope_path", "mission_scope_sha256", "review_prompt_sha256", "review_started_at", "review_completed_at", "review_result", "finding_counts_by_severity", "findings", "raw_output_sha256", "final_result_sha256", "isolation", "provenance", "integrity"],
  "properties": {
    "protocol_version": {"const": "INDEPENDENT_REVIEW_PROTOCOL_V1"}, "receipt_version": {"const": "independent-review-receipt/v1"},
    "review_run_id": {"pattern": "^[a-z0-9][a-z0-9-]{7,127}$"}, "review_backend": {"pattern": "^[a-z0-9][a-z0-9-]{1,63}$"}, "review_harness": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "requested_model": {"type": "string", "minLength": 1}, "resolved_model": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}, "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}, "diff_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "mission_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}, "mission_scope_path": {"type": "string", "pattern": "^docs/agentic/missions/[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}\\.json$"}, "mission_scope_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "review_prompt_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}, "review_started_at": {"type": "string", "format": "date-time"}, "review_completed_at": {"type": "string", "format": "date-time"},
    "review_result": {"enum": ["PASS", "FAIL"]}, "finding_counts_by_severity": {"type": "object", "additionalProperties": false, "required": ["P0", "P1", "P2", "P3"], "properties": {"P0": {"type": "integer", "minimum": 0}, "P1": {"type": "integer", "minimum": 0}, "P2": {"type": "integer", "minimum": 0}, "P3": {"type": "integer", "minimum": 0}}}, "findings": {"type": "array"},
    "raw_output_sha256": {"pattern": "^[0-9a-fA-F]{64}$"}, "final_result_sha256": {"pattern": "^[0-9a-fA-F]{64}$"}, "isolation": {"type": "object", "additionalProperties": false, "required": ["fresh_process", "fresh_context", "detached_worktree", "read_only", "worktree_head_sha", "worktree_clean_before", "worktree_clean_after"], "properties": {"fresh_process": {"const": true}, "fresh_context": {"const": true}, "detached_worktree": {"const": true}, "read_only": {"const": true}, "worktree_head_sha": {"pattern": "^[0-9a-fA-F]{40}$"}, "worktree_clean_before": {"const": true}, "worktree_clean_after": {"const": true}}}, "provenance": {"type": "object"}, "integrity": {"type": "object", "additionalProperties": false, "required": ["receipt_payload_sha256"], "properties": {"receipt_payload_sha256": {"pattern": "^[0-9a-fA-F]{64}$"}}}
  }
}
