{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footballprediction.local/schemas/agentic/codex-independent-review-receipt-v1.json",
  "title": "Independent Codex Review Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_schema_version",
    "review_engine",
    "review_role",
    "base_sha",
    "reviewed_head_sha",
    "review_challenge",
    "diff_sha256",
    "mission_id",
    "review_started_at",
    "review_completed_at",
    "finding_counts_by_severity",
    "blocking_findings",
    "review_result",
    "findings",
    "reviewer_invocation_id",
    "builder_context_id",
    "reviewer_context_id",
    "reviewer_read_only",
    "isolation",
    "provenance",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "codex-independent-review-receipt/v1"},
    "contract_schema_version": {"const": "agentic-engineering-workflow/v1"},
    "review_engine": {"const": "codex"},
    "review_role": {"const": "independent_reviewer"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "reviewed_head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "review_challenge": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diff_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "mission_id": {"type": "string", "minLength": 1},
    "review_started_at": {"type": "string", "format": "date-time"},
    "review_completed_at": {"type": "string", "format": "date-time"},
    "finding_counts_by_severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0", "P1", "P2", "P3"],
      "properties": {
        "P0": {"type": "integer", "minimum": 0},
        "P1": {"type": "integer", "minimum": 0},
        "P2": {"type": "integer", "minimum": 0},
        "P3": {"type": "integer", "minimum": 0}
      }
    },
    "blocking_findings": {"type": "integer", "minimum": 0},
    "review_result": {"enum": ["PASS", "FAIL"]},
    "findings": {"type": "array"},
    "reviewer_invocation_id": {"type": "string", "minLength": 4},
    "builder_context_id": {"type": "string", "minLength": 1},
    "reviewer_context_id": {"type": "string", "minLength": 4},
    "reviewer_read_only": {"const": true},
    "isolation": {
      "type": "object",
      "required": ["fresh_process", "persisted_session_artifact", "sandbox", "detached_worktree", "worktree_head_sha", "worktree_path"],
      "properties": {
        "fresh_process": {"const": true},
        "persisted_session_artifact": {"const": true},
        "sandbox": {"const": "read-only"},
        "detached_worktree": {"const": true},
        "worktree_head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "worktree_path": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "writer",
        "wrapper_sha256",
        "command_sha256",
        "prompt_sha256",
        "codex_binary",
        "codex_binary_sha256",
        "codex_session_path",
        "codex_session_sha256",
        "codex_session_thread_id",
        "codex_session_index_path",
        "codex_session_index_entry_sha256"
      ],
      "properties": {
        "writer": {"type": "string", "minLength": 1},
        "wrapper_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "command_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "codex_binary": {"type": "string", "minLength": 1},
        "codex_binary_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "codex_session_path": {"type": "string", "minLength": 1},
        "codex_session_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "codex_session_thread_id": {"type": "string", "minLength": 4},
        "codex_session_index_path": {"type": "string", "minLength": 1},
        "codex_session_index_entry_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "integrity": {
      "type": "object",
      "required": ["receipt_payload_sha256"],
      "properties": {
        "receipt_payload_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  }
}
