{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://footballprediction.local/schemas/agentic/codex-independent-review-receipt.json",
  "title": "Independent Codex Review Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_schema_version",
    "assurance_model",
    "hostile_same_uid_forge_resistance",
    "review_engine",
    "review_role",
    "base_sha",
    "reviewed_head_sha",
    "review_challenge",
    "diff_sha256",
    "mission_id",
    "review_started_at",
    "review_completed_at",
    "finding_counts_by_severity",
    "blocking_findings",
    "review_result",
    "findings",
    "mission_scope_path",
    "mission_scope_sha256",
    "reviewer_invocation_id",
    "builder_context_id",
    "reviewer_context_id",
    "reviewer_context_separate_from_builder",
    "reviewer_read_only",
    "isolation",
    "provenance",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "description": "v1 receipts stay classifiable as historical evidence; only v2 records pinned model provenance.",
      "enum": [
        "codex-independent-review-receipt/v1",
        "codex-independent-review-receipt/v2"
      ]
    },
    "contract_schema_version": {"const": "agentic-engineering-workflow/v1"},
    "assurance_model": {"const": "engineering_independent_review"},
    "hostile_same_uid_forge_resistance": {"const": false},
    "review_engine": {"const": "codex"},
    "review_role": {"const": "independent_reviewer"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "reviewed_head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "review_challenge": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diff_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "mission_id": {"type": "string", "minLength": 1},
    "review_started_at": {"type": "string", "format": "date-time"},
    "review_completed_at": {"type": "string", "format": "date-time"},
    "finding_counts_by_severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0", "P1", "P2", "P3"],
      "properties": {
        "P0": {"type": "integer", "minimum": 0},
        "P1": {"type": "integer", "minimum": 0},
        "P2": {"type": "integer", "minimum": 0},
        "P3": {"type": "integer", "minimum": 0}
      }
    },
    "blocking_findings": {"type": "integer", "minimum": 0},
    "review_result": {"enum": ["PASS", "FAIL"]},
    "findings": {"type": "array"},
    "mission_scope_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "mission_scope_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "reviewer_invocation_id": {"type": "string", "minLength": 4},
    "builder_context_id": {"type": "string", "minLength": 1},
    "reviewer_context_id": {"type": "string", "minLength": 4},
    "reviewer_context_separate_from_builder": {"const": true},
    "reviewer_read_only": {"const": true},
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh_process", "ephemeral_session", "sandbox", "detached_worktree", "worktree_head_sha", "worktree_path", "worktree_clean_before", "worktree_clean_after", "source_mutation_detected"],
      "properties": {
        "fresh_process": {"const": true},
        "ephemeral_session": {"const": true},
        "sandbox": {"const": "read-only"},
        "detached_worktree": {"const": true},
        "worktree_head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "worktree_path": {"type": "string", "minLength": 1},
        "worktree_clean_before": {"const": true},
        "worktree_clean_after": {"const": true},
        "source_mutation_detected": {"const": false}
      }
    },
    "model_provenance": {
      "description": "Required for v2 receipts. Every value is derived from the executed reviewer command or observed from the resolved Codex binary, never from a Builder declaration.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_model",
        "review_reasoning_effort",
        "codex_cli_version",
        "model_source",
        "reasoning_effort_source",
        "cli_version_source",
        "derived_from_recorded_command"
      ],
      "properties": {
        "review_model": {"type": "string", "minLength": 1},
        "review_reasoning_effort": {
          "enum": ["minimal", "low", "medium", "high"]
        },
        "codex_cli_version": {"type": "string", "minLength": 1},
        "model_source": {"const": "codex_exec_model_flag"},
        "reasoning_effort_source": {"const": "codex_config_override"},
        "cli_version_source": {"const": "observed_codex_version_stdout"},
        "derived_from_recorded_command": {"const": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writer",
        "integrity_only",
        "wrapper_sha256",
        "command_sha256",
        "prompt_sha256",
        "codex_binary",
        "codex_binary_sha256",
        "output_schema_path",
        "output_schema_sha256",
        "raw_output_path",
        "raw_output_sha256",
        "agent_message_sha256",
        "codex_exit_code",
        "stderr_path",
        "final_message_path",
        "final_message_sha256"
      ],
      "properties": {
        "writer": {"type": "string", "minLength": 1},
        "integrity_only": {"const": true},
        "wrapper_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "command_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "reviewer_command": {
          "description": "Exact argv of the executed reviewer; required for v2 and hash-bound by command_sha256.",
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "codex_binary": {"type": "string", "minLength": 1},
        "codex_binary_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "output_schema_path": {"type": "string", "minLength": 1},
        "output_schema_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "raw_output_path": {"type": "string", "minLength": 1},
        "raw_output_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "agent_message_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "codex_exit_code": {"const": 0},
        "stderr_path": {"type": "string", "minLength": 1},
        "final_message_path": {"type": "string", "minLength": 1},
        "final_message_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_payload_sha256"],
      "properties": {
        "receipt_payload_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "codex-independent-review-receipt/v2"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["model_provenance"],
        "properties": {"provenance": {"required": ["reviewer_command"]}}
      }
    }
  ]
}
