{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "footballprediction-market-observation/v1",
    "title": "FootballPrediction MarketObservation",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "projection_version",
        "observation_id",
        "canonical_event_id",
        "provider",
        "provider_event_id",
        "canonical_market_id",
        "provider_market_id",
        "canonical_bookmaker_id",
        "provider_bookmaker_id",
        "provider_bookmaker_name",
        "competition",
        "season",
        "home_team",
        "away_team",
        "kickoff_utc",
        "period",
        "market_type",
        "line",
        "canonical_selection_id",
        "selection",
        "price_side",
        "odds_decimal",
        "available_volume",
        "bet_limit",
        "bookmaker_last_update_at",
        "source_snapshot_at",
        "capture_started_at",
        "response_received_at",
        "ingested_at",
        "acquisition_mode",
        "capture_id",
        "raw_evidence_reference",
        "raw_sha256",
        "adapter_name",
        "adapter_version",
        "identity_registry_version",
        "quality_flags"
    ],
    "properties": {
        "schema_version": { "const": "footballprediction-market-observation/v1" },
        "projection_version": { "type": "string", "minLength": 1 },
        "observation_id": { "type": "string", "minLength": 1 },
        "canonical_event_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "provider_event_id": { "type": "string", "minLength": 1 },
        "canonical_market_id": { "type": "string", "minLength": 1 },
        "provider_market_id": { "type": "string", "minLength": 1 },
        "canonical_bookmaker_id": { "type": "string", "minLength": 1 },
        "provider_bookmaker_id": { "type": "string", "minLength": 1 },
        "provider_bookmaker_name": { "type": "string", "minLength": 1 },
        "competition": { "const": "English Premier League" },
        "season": { "type": ["string", "null"] },
        "home_team": { "type": "string", "minLength": 1 },
        "away_team": { "type": "string", "minLength": 1 },
        "kickoff_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" },
        "period": { "enum": ["MATCH", "FIRST_HALF"] },
        "market_type": { "enum": ["1X2", "ASIAN_HANDICAP", "TOTAL"] },
        "line": { "type": ["number", "null"] },
        "canonical_selection_id": { "type": "string", "minLength": 1 },
        "selection": { "enum": ["HOME", "DRAW", "AWAY"] },
        "price_side": { "enum": ["BOOKMAKER", "BACK", "LAY"] },
        "odds_decimal": { "type": "number", "exclusiveMinimum": 1 },
        "available_volume": { "type": ["number", "null"], "minimum": 0 },
        "bet_limit": { "type": ["number", "null"], "minimum": 0 },
        "bookmaker_last_update_at": { "type": ["string", "null"] },
        "source_snapshot_at": { "type": ["string", "null"] },
        "capture_started_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" },
        "response_received_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" },
        "ingested_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" },
        "acquisition_mode": { "enum": ["LIVE_CAPTURE", "HISTORICAL_API", "HISTORICAL_FILE", "REPLAY"] },
        "capture_id": { "type": "string", "minLength": 1 },
        "raw_evidence_reference": { "type": "string", "minLength": 1 },
        "raw_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "adapter_name": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "identity_registry_version": { "type": "string", "minLength": 1 },
        "quality_flags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
    }
}
